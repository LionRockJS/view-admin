<div class="panel-space">
  <h2 class="text-3xl pb-0">Role: {{ item.name }}</h2>
  <div class="text-xs text-gray-500">ID: {{ item.id }}</div>
</div>

<div class="panel-space">
  <form action="/admin/roles/{{item.id}}" method="post" enctype="multipart/form-data">
    <div class="mb-4 w-full relative">
      <div class="absolute text-xs bg-gray-50 -top-2 left-2 text-gray-500">Role Name</div>
      <input 
        type="text" 
        name=":name" 
        aria-label="Role Name" 
        id="name" 
        value="{{ item.name }}"
        required
        class="text-ellipsis transition-[background] duration-[50000s] block font-sans text-xl w-full ps-2 py-2 bg-white border-1 border-gray-300 rounded grow p-0 text-gray-800 placeholder:text-gray-400 placeholder:font-[200] focus:outline-none focus:text-highlight"
      >
    </div>

    {% for sibling in belongsToMany %}
      <hr class="my-4">
      <h3 class="text-2xl mb-3">Users with this role</h3>
      <input type="hidden" name="~{{sibling.model.className}}[]" value="replace">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
        {% for x in sibling.items %}
          <div class="flex items-start">
            <div class="flex h-6 items-center">
              <input
                type="checkbox"
                id="{{sibling.model.className}}{{x.id}}"
                name="~{{sibling.model.className}}[]"
                value="{{x.id}}"
                {% if x.linked %}
                  checked="checked"
                {% endif %}
                class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"
              >
            </div>
            <div class="ml-3 text-sm">
              <label class="select-none font-medium text-gray-900" for="{{sibling.model.className}}{{x.id}}">
                {{- x.displayName | default: x.id -}}
              </label>
            </div>
          </div>
        {% endfor %}
      </div>
    {% endfor %}

    <hr class="my-4">
    
    <div class="flex gap-2">
      {% if item.id != blank %}
        <a
          href="/admin/{{model.tableName}}/delete/{{item.id}}{% if checkpoint != blank %}?cp={{ checkpoint }}{% endif %}"
          class="button-danger"
          >Delete Role</a
        >
      {% endif %}

      {% if checkpoint != blank %}
        <a href="{{ checkpoint }}" class="button-secondary">Back</a>
      {% else %}
        <a href="/admin/{{model.tableName}}" class="button-secondary">Back</a>
      {% endif %}

      <input
        type="submit"
        value="Update Role"
        class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600"
      >
    </div>
  </form>
</div>
