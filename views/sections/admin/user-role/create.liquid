<div class="container mx-auto px-4">
    <h2 class="text-3xl mb-4">Create Role</h2>
    <form autocomplete="off" action="/admin/roles/new" method="post">
        <div class="mb-3 w-full relative">
            <div class="absolute text-xs bg-gray-50 -top-2 left-2 text-gray-500">Role Name</div>
            <input type="text" name=":name" aria-label="Role Name" id="name" 
                class="text-ellipsis transition-[background] duration-[50000s] block font-sans text-xl w-full ps-2 py-2 bg-white border-1 border-gray-300 rounded grow p-0 text-gray-800 placeholder:text-gray-400 placeholder:font-[200] focus:outline-none focus:text-highlight" 
                value="" 
                placeholder="e.g., editor, viewer, moderator" 
                required="">
        </div>

        <div class="mb-4">
            <p class="text-sm text-gray-600">Enter a unique name for this role. Common examples: admin, editor, viewer, moderator.</p>
        </div>

        <button type="submit" class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">Create Role</button>
    </form>
</div>